# ==============================================================================
# NEURALCLIPS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core System
NEURALCLIPS_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=d:\vidclip\data\neuralclips.db
MEDIA_STORAGE_DIR=d:\vidclip\storage

# AI Analysis Engine
# Supported: "agent" (Antigravity Assistant - default, NO API KEY REQUIRED) or "gemini"
AI_PROVIDER=agent
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 OAuth Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CHANNEL_ID=your_destination_channel_id

# Meta / Instagram Graph API Credentials
# Target account MUST be an Instagram Professional (Business or Creator) account
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# Media Hosting (Required by Instagram Graph API to retrieve videos)
# Instagram Reels API requires an HTTPS public or pre-signed URL to ingest video
MEDIA_PUBLIC_BASE_URL=https://your-storage-bucket.domain.com/clips
S3_BUCKET_NAME=neuralclips-public-media
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_s3_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# FFmpeg Paths (Leave blank if ffmpeg is in system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Daily Limits and Thresholds
DAILY_CLIP_TARGET=100
MIN_HIGHLIGHT_SCORE=75
MAX_YOUTUBE_UPLOADS_DAILY=100
MAX_INSTAGRAM_UPLOADS_DAILY=50
